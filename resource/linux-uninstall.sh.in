#!/bin/sh

# The uninstallation script of the package: it removes the files of the
# selected plugins from the vamp directory of the user.

ThisPath="$( cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
PLUGINS="@PVP_PLUGINS_STRING@"
VAMP_DIRECTORY="$HOME/vamp"

# The plugins can be passed as arguments of the script (or all the plugins
# with the option --all), otherwise the plugins are prompted one by one (with
# a terminal) or all the plugins are removed (without a terminal).
SELECTED=""
if [ "$#" -gt 0 ]; then
    if [ "$1" = "--all" ]; then
        SELECTED="$PLUGINS"
    else
        for PLUGIN_ARGUMENT in "$@"; do
            case " $PLUGINS " in
                *" $PLUGIN_ARGUMENT "*)
                    SELECTED="$SELECTED $PLUGIN_ARGUMENT"
                    ;;
                *)
                    echo "Unknown plugin $PLUGIN_ARGUMENT"
                    echo "Usage: $(basename "$0") [--all] | plugin1 plugin2 ..."
                    exit 1
                    ;;
            esac
        done
    fi
elif [ -t 0 ]; then
    for PLUGIN_NAME in $PLUGINS; do
        printf "Uninstall %s? [y/N] " "$PLUGIN_NAME"
        read PLUGIN_ANSWER
        case "$PLUGIN_ANSWER" in
            [yY]*)
                SELECTED="$SELECTED $PLUGIN_NAME"
                ;;
        esac
    done
else
    SELECTED="$PLUGINS"
fi

if [ -z "$SELECTED" ]; then
    echo "No plugin selected."
    exit 0
fi

plugin_selected()
{
    case " $SELECTED " in
        *" $1 "*)
            return 0
            ;;
    esac
    return 1
}

# Remove the files of a plugin (the legacy library + cat files and the .vamp bundle).
uninstall_plugin()
{
    rm -f "$1/$2.so" "$1/$2.cat"
    rm -rf "$1/$2.vamp"
}

@PVP_UNINSTALL_BLOCKS@

exit 0
