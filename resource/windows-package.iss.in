; Inno Setup script of the Windows installer of all the plugins.
; The plugin-dependent sections ([Components], [InstallDelete] and [Files])
; are generated by GeneratePackages.cmake from the resource/plugins.json file.
#define MyAppName "Partiels Vamp Plugins"
#define MyAppPublisher "Ircam"
#define MyAppURL "www.ircam.fr"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{844440AC-BE7A-4740-AC5C-EDE795894A63}
AppName={#MyAppName}
AppVerName={#MyAppVerName}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName="{commonpf64}\Vamp Plugins"
DisableProgramGroupPage=yes
DisableDirPage=no
OutputDir=..\build
InfoBeforeFile={#MyPackageFolder}\About.txt
OutputBaseFilename={#MyAppName}-install
Compression=lzma
SolidCompression=yes
WizardStyle=modern
ChangesEnvironment=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Types]
Name: "full"; Description: "Full installation"
Name: "custom"; Description: "Custom installation"; Flags: iscustom

[Components]
@PVP_COMPONENTS@

[InstallDelete]
; The legacy versions (library + cat files) and the .vamp bundles of the plugins are removed before the installation.
; Each plugin can have been installed with its legacy name (e.g. SuperVP) or with the ircam-formatted name (e.g. ircamsupervp).
; The entries are only processed for the components selected by the user.
@PVP_INSTALL_DELETES@

[Files]
@PVP_FILES@
