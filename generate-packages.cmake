cmake_minimum_required(VERSION 3.19)

# The generation of the packages of the Partiels Vamp plugins. The properties
# of the plugins are defined in the resource/plugins.json file (see
# cmake/plugins.cmake) and each operating system is generated by its module
# in the cmake directory. The installers are collected in the package
# directory of the repository.
#
# Command line options:
#  - PVP_BUILD_TAG: the version of the package (by default 1.0.0),
#  - PVP_GENERATE_LINUX: generate the Linux package on another operating
#    system (the Linux package does not depend on the operating system),
#  - PVP_GENERATE_MANUALS: generate the manuals package,
#  - PVP_GENERATE_PLUGIN_INSTALLERS: generate one installer per plugin (ON),
#  - SUPERVP_REF, IRCAMBEAT_REF, ...: override the ref of a plugin,
#  - PRIVATE_TOKEN or the FORGE_PRIVATE_TOKEN environment variable: the token
#    used to download the plugins hosted on the Ircam Forge 2,
#  - PVP_CODESIGN_APPLE_DEV_ID_APPLICATION_CERT, PVP_CODESIGN_APPLE_DEV_ID_INSTALLER_CERT
#    and PVP_CODESIGN_APPLE_KEYCHAIN_PROFILE_INSTALLER: the Apple certificates
#    used to sign and notarize the installers.
#
# Usage:
#  mkdir build && cd build
#  cmake -D PVP_BUILD_TAG="1.0.0" -P ../generate-packages.cmake

get_filename_component(PVP_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)

include("${PVP_ROOT_DIR}/cmake/config.cmake")
include("${PVP_ROOT_DIR}/cmake/plugins.cmake")
include("${PVP_ROOT_DIR}/cmake/common.cmake")
include("${PVP_ROOT_DIR}/cmake/download.cmake")
include("${PVP_ROOT_DIR}/cmake/prepare.cmake")

pvp_read_plugins()

# Each package generation is defined by its module. The MacOS and Windows
# packages must be generated on their respective operating systems.
if(PVP_GENERATE_MANUALS)
  include("${PVP_ROOT_DIR}/cmake/package-manuals.cmake")
elseif(WIN32 AND NOT PVP_GENERATE_LINUX)
  include("${PVP_ROOT_DIR}/cmake/package-windows.cmake")
elseif(APPLE AND NOT PVP_GENERATE_LINUX)
  include("${PVP_ROOT_DIR}/cmake/package-macos.cmake")
elseif(UNIX OR PVP_GENERATE_LINUX)
  include("${PVP_ROOT_DIR}/cmake/package-linux.cmake")
endif()
